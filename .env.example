# Supabase browser config. These two variables are safe to expose in the frontend.
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Volcengine Ark / Doubao server config. Keep these only in Vercel server env vars.
ARK_API_KEY="YOUR_ARK_API_KEY"
ARK_MODEL_ID="YOUR_ARK_ENDPOINT_OR_MODEL_ID"
ARK_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"

# Production URL. Set in Vercel env vars to your deployed domain.
# Used by Nominatim User-Agent / Referer headers and other server-side needs.
SITE_URL="https://your-app.vercel.app"
